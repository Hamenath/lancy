datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CLIENT
  FREELANCER
  ADMIN
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  name         String
  role         String             @default("FREELANCER")
  photo        String?
  firebaseUid  String?            @unique
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  profile      FreelancerProfile?
  projects     Project[]          @relation("ClientProjects")
  proposals    Proposal[]         @relation("FreelancerProposals")
}

model FreelancerProfile {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  bio          String?
  hourlyRate   Float     @default(0)
  location     String?   @default("Remote")
  skills       String    @default("Figma, React, UI/UX") // Stored as comma-separated string in SQLite
  rating       Float     @default(5.0)
  reviewsCount Int       @default(0)
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Project {
  id          String     @id @default(uuid())
  title       String
  description String
  budget      Float      @default(0)
  category    String?
  imageUrl    String?
  status      String     @default("OPEN")
  clientId    String
  client      User       @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)
  proposals   Proposal[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Proposal {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancerId String
  freelancer   User     @relation("FreelancerProposals", fields: [freelancerId], references: [id], onDelete: Cascade)
  bidAmount    Float
  coverLetter  String
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
